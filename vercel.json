{
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
